# Required: one or more directories to scan recursively for local video files.
# Supports ~ expansion and environment variable substitution ($VAR or ${VAR}).
# Separate multiple directories with commas or semicolons.
# Examples:
#   ./videos
#   ./videos,~/Videos
#   $HOME/Videos;${HOME}/Movies
LOCALTUBE_VIDEO_ROOTS=./videos

# Optional: defaults shown here match runtime defaults.
# All config values support ~ expansion and environment variable substitution
LOCALTUBE_SQLITE_PATH=./localtube.db
LOCALTUBE_THUMBNAIL_CACHE_DIR=./.localtube-thumbnails
LOCALTUBE_FRONTEND_DIST_DIR=../frontend/dist
