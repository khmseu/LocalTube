{
  "name": "@localtube/backend",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node ../../scripts/sync-version.mjs && tsc -p tsconfig.json",
    "start:run": "LOCALTUBE_VIDEO_ROOT=${LOCALTUBE_VIDEO_ROOT:-./videos} node dist/src/index.js",
    "start": "npm run build && LOCALTUBE_VIDEO_ROOT=${LOCALTUBE_VIDEO_ROOT:-./videos} node dist/src/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
